<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#2A2A2A"
                android:endColor="#030303"
                android:startColor="#121212" />
        </shape>
    </item>
    <item
        android:bottom="96dp"
        android:left="56dp"
        android:right="56dp"
        android:top="180dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#33FFFFFF"
                android:endColor="#00000000"
                android:gradientRadius="220dp"
                android:startColor="#66FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
