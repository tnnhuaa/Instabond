<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="22dp"
    android:paddingEnd="16dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/iv_comment_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/avatar_circle_bg"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_user_avatar"
        android:scaleType="centerCrop"
        android:src="@drawable/avatar_circle_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_comment_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/login_text_primary"
                android:textSize="14sp"
                tools:text="marcus_design" />

            <TextView
                android:id="@+id/tv_comment_author_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/comment_author_badge_bg"
                android:fontFamily="sans-serif-black"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/comment_author_badge"
                android:textColor="@color/login_bg_start"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_comment_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/feed_meta"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="5" />

            <ImageView
                android:id="@+id/iv_comment_like"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_like"
                android:src="@drawable/ic_heart" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/login_text_secondary"
            android:textSize="14sp"
            tools:text="The composition of the third slide is absolutely incredible. Minimalist yet warm. Love it!" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:textColor="@color/feed_meta"
                android:textSize="10sp"
                tools:text="1H AGO" />

            <TextView
                android:id="@+id/tv_comment_reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="@string/comment_reply_action"
                android:textAllCaps="true"
                android:textColor="@color/feed_meta"
                android:textSize="10sp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
