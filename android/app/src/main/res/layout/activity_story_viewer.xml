<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111114">

    <ImageView
        android:id="@+id/iv_story_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/story_view_content"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/story_viewer_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/story_viewer_bottom_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <ProgressBar
                android:id="@+id/progress_story_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF" />

            <ProgressBar
                android:id="@+id/progress_story_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF" />

            <ProgressBar
                android:id="@+id/progress_story_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF" />

            <ProgressBar
                android:id="@+id/progress_story_4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF" />

            <ProgressBar
                android:id="@+id/progress_story_5"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <FrameLayout
                android:id="@+id/story_avatar_ring"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/story_viewer_send_button_bg"
                android:padding="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_story_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/avatar_circle_bg"
                    android:clipToOutline="true"
                    android:contentDescription="@string/cd_user_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_placeholder_bg" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/story_avatar_ring"
                app:layout_constraintEnd_toStartOf="@id/btn_close_story"
                app:layout_constraintStart_toEndOf="@id/story_avatar_ring"
                app:layout_constraintTop_toTopOf="@id/story_avatar_ring">

                <TextView
                    android:id="@+id/tv_story_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_story_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_story"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/story_viewer_glass_button"
                android:contentDescription="@string/cd_dismiss"
                android:padding="11dp"
                android:src="@drawable/ic_close_small"
                app:layout_constraintBottom_toBottomOf="@id/story_avatar_ring"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/story_avatar_ring"
                app:tint="@android:color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/story_reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <EditText
            android:id="@+id/et_story_reply"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/story_viewer_glass_input"
            android:clickable="true"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/story_view_reply_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@android:color/white"
            android:textColorHint="#B3FFFFFF" />

        <ImageButton
            android:id="@+id/btn_story_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/story_viewer_glass_button"
            android:contentDescription="@string/cd_like"
            android:padding="12dp"
            android:src="@drawable/ic_heart_filled"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_story_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/story_viewer_send_button_bg"
            android:contentDescription="@string/cd_share"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            app:tint="@android:color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_story_viewers_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="46dp"
        android:background="@drawable/story_viewer_glass_button"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_story_more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="46dp"
        android:background="@drawable/story_viewer_glass_button"
        android:contentDescription="@string/cd_more_options"
        android:padding="12dp"
        android:src="@drawable/ic_more_vertical"
        android:visibility="gone"
        app:tint="@android:color/white" />

    <View
        android:id="@+id/story_tap_left"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="124dp"
        android:background="@android:color/transparent" />

    <View
        android:id="@+id/story_tap_right"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="124dp"
        android:background="@android:color/transparent" />

</FrameLayout>
