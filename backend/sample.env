# MongoDB Atlas Configuration
# Note: Should include the database name in the URI for Spring Data
MONGODB_URI=mongodb+srv://admin:yourpassword@cluster0.example.mongodb.net/instabond?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security
# Tip: Use a long random string (at least 32 characters)
JWT_SECRET_KEY=your_random_secret_key_must_be_long_enough_32_chars

# Mail Service (Gmail SMTP)
# Use "App Password" instead of regular Gmail password
MAIL_USERNAME=your_account@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# AI Service Integration
# Threshold for face recognition or music suggestions (0.4 -> 0.6)
AI_CONFIDENCE_THRESHOLD=0.5

# Presence Service Configuration
PRESENCE_REDIS_ENABLED=true
PRESENCE_TTL_MINUTES=5
PRESENCE_RETRY_BACKOFF_SECONDS=30